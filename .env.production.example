# Copy to .env.production (and optionally .env) before docker compose build
VITE_API_BASE_URL=https://web.rioassetmanagement.net/api
VITE_FRONTEND_URL=https://web.rioassetmanagement.net

# Optional Zoho SSO button on login (backend ZOHO_OIDC_* must also be enabled)
VITE_ZOHO_SSO_ENABLED=false
VITE_ZOHO_LOGIN_URL=https://rioassetmanagement.net/api/auth/zoho/login
